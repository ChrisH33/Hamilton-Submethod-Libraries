_blnSim = HSLML_STAR::IsSimulatorMode(ML_STAR);
// }} ""
if (_blnSim == 1){
   Trace("[SlackMes] -- Device in sim mode; no update");
   return;
}
// {{ 32 1 0 "bb711ce4_8dfd_4ef3_8fa7ca7e98fdd80f" "{F07B0071-8EFC-11d4-A3BA-002035848439}"

// }} ""
// {{ 33 1 0 "6bf508bf_8ee9_44bb_a9f1af7c997e3854" "{B31F3531-5D80-11d4-A5EB-0050DA737D89}"
if (blnSlack == 1)
{
// }} ""
// {{ 34 1 0 "88f72736_d457_4478_af71748c744503ae" "{F07B0071-8EFC-11d4-A3BA-002035848439}"

// }} ""
// {{{ 35 1 0 "8f08f5b8_c13b_4996_a9c8937b214f02e6" "{7C4EF7A7-39BE-406a-897F-71F3A35B4093}"
_strDirPath = _GetUploadDir(Translate(":\\0.051 Research & Development\\Instrumentation\\SlackUpdates"));
// }} ""
if (_strDirPath == ""){
   Trace("[SlackMes] -- Failed to locate/access the upload directory");
   return;
}
// {{ 37 1 0 "7088cac7_9f84_4c99_bd31ead8c063a146" "{F07B0071-8EFC-11d4-A3BA-002035848439}"

// }} ""
// {{{ 38 1 0 "91595959_b770_43e7_9b74ce0a475214c4" "{C1F3C015-47B3-4514-9407-AC2E65043419}"
_strSN = GetSN(ML_STAR, 0);
// }} ""
// {{{ 39 1 0 "715680c8_ba59_4b8d_894b850321581ec4" "{C1F3C015-47B3-4514-9407-AC2E65043419}"
_strFilePath = StrConcat4(_strDirPath, Translate("\\"), _strSN, Translate("_Update.txt"));
// }} ""
// {{ 40 1 0 "9dfc7471_59f7_407a_9f39653ff4471401" "{F07B0071-8EFC-11d4-A3BA-002035848439}"

// }} ""
// {{{ 41 1 0 "ceb60641_1272_4e21_bd3a80e0e3b8b905" "{7C4EF7A7-39BE-406a-897F-71F3A35B4093}"
_strTimeStamp = _GetTimeStamp();
// }} ""
// {{ 42 1 0 "536ba1ec_514b_4bca_a7baffc200a286fc" "{F07B0071-8EFC-11d4-A3BA-002035848439}"

// }} ""
// {{{ 43 1 0 "58f62fd4_71bc_4e83_987ef25d9c01def5" "{C1F3C015-47B3-4514-9407-AC2E65043419}"
_strMethod = GetMethodName(0);
// }} ""
// {{ 44 1 0 "a78af1b2_20d2_4cb1_8c214f3ef43b131b" "{3293659E-F71E-472f-AFB4-6A674E32B114}"
onerror goto errLabel_1CE81AD2C2724aa4BF407E2D387A9162 ;
err.Clear();
// }} ""
// {{ 45 1 0 "cbf33110_b0cf_4123_96c4a110a43fd246" "{B31F3534-5D80-11d4-A5EB-0050DA737D89}"
_hnd.AddField("Instrument", _strSN, hslString, 255);
_hnd.AddField("State", i_strSlackMessage, hslString, 255);
_hnd.AddField("Method", _strMethod, hslString, 255);
_hnd.AddField("UpdateTime", _strTimeStamp, hslString, 255);
_hnd.SetDelimiter(hslCSVDelimited);
if( 0 == _hnd.Open(_strFilePath, hslWrite) )
{
    MECC::RaiseRuntimeErrorEx(-1523711743, MECC::IDS::stepNameFileOpen, MECC::IDS::errorStepFileOpenFailed, _strFilePath, "HxMetEdCompCmd");
}
// }} ""
// {{ 46 1 0 "d4364419_866c_42cd_ba68161aa881ef64" "{B31F3537-5D80-11d4-A5EB-0050DA737D89}"
if( 0 == _hnd.WriteRecord() )
{
    MECC::RaiseRuntimeErrorEx(-1473380096, MECC::IDS::stepNameFileWrite, MECC::IDS::errorStepFailed, "", "HxMetEdCompCmd");
}
// }} ""
// {{ 47 1 0 "062f2990_087e_4a8f_bec347e5d59c6520" "{B31F3538-5D80-11d4-A5EB-0050DA737D89}"
if( 0 != _hnd.Close() )
{
    MECC::RaiseRuntimeErrorEx(-1456602880, MECC::IDS::stepNameFileClose, MECC::IDS::errorStepFailed, "", "HxMetEdCompCmd");
}
_hnd.RemoveFields();
// }} ""
// {{ 48 1 0 "a78af1b2_20d2_4cb1_8c214f3ef43b131b" "{3293659E-F71E-472f-AFB4-6A674E32B114}"
